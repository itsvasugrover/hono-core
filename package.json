{
  "name": "@vasugrover/hono-core",
  "type": "module",
  "version": "1.0.0",
  "private": false,
  "description": "Core library for building production-ready Hono APIs with built-in middlewares, OpenAPI docs, and enterprise patterns",
  "license": "MIT",
  "homepage": "https://github.com/itsvasugrover/hono-core#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsvasugrover/hono-core.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "hono",
    "api",
    "rest",
    "openapi",
    "middleware",
    "cors",
    "logging",
    "error-handling",
    "typescript",
    "zod",
    "scalar"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "LICENSE",
    "README.md",
    "src"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "lint": "bunx biome lint .",
    "format": "bunx biome format --write .",
    "check": "bunx biome check --write .",
    "ci:check": "bunx biome ci .",
    "typecheck": "tsc --noEmit"
  },

  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.2.0",
    "@scalar/hono-api-reference": "^0.10.0",
    "@vasugrover/bun-env": "^1.0.0",
    "@vasugrover/bun-logger": "^1.0.0",
    "@vasugrover/hono-middlewares": "^1.0.0",
    "@vasugrover/hono-openapi": "^1.0.0",
    "@vasugrover/http-status": "^1.0.0",
    "hono": "^4.11.4",
    "pino": "^10.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@types/bun": "latest",
    "@vasugrover/biome-config": "^1.0.0",
    "@vasugrover/typescript-config": "^1.0.0"
  }
}
